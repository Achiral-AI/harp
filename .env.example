# =============================================================================
# warp-local-inference configuration
#
# Copy this file to `.env` and fill in values appropriate to your setup.
# =============================================================================

# -- Shim ---------------------------------------------------------------------

# proxy      : transparent reverse proxy only (no local inference)
# hijack     : try local model first, fall back to upstream
# local-only : never forward upstream (air-gapped use)
SHIM_MODE=proxy

# Bind address inside the shim container.
SHIM_HOST=0.0.0.0
SHIM_PORT=8787

# Warp's real backend. The shim transparently proxies everything here that it
# does not handle locally.
UPSTREAM_BASE_URL=https://app.warp.dev

# Bytes; requests larger than this are forwarded upstream without local handling.
SHIM_MAX_LOCAL_REQUEST_BYTES=131072

# -- LiteLLM ------------------------------------------------------------------

# OpenAI-compatible endpoint exposed by the litellm container. The shim talks to
# this when serving requests locally.
LITELLM_BASE_URL=http://litellm:4000/v1

# Master key the shim uses to authenticate with the litellm container.
# (LiteLLM requires *some* API key even for unauthenticated access.)
LITELLM_MASTER_KEY=sk-warp-local-shim

# Path to the LiteLLM config mounted into the litellm container. Defaults to
# the bundled Ollama config; copy `litellm/config.local.yaml.example` to
# `litellm/config.local.yaml` and point this at it for a personal setup
# (e.g. multi-replica vLLM, TRT-LLM, or vLLM behind a NodePort).
LITELLM_CONFIG=./litellm/config.yaml

# -- Local model runtime ------------------------------------------------------

# When the litellm container needs to reach a model runtime on the host
# (Ollama, vLLM, LM Studio), it uses host.docker.internal on macOS/Windows.
# On Linux you may need to set this to your host's LAN IP.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama model name used as the local primary. Pull it first with:
#   ollama pull qwen2.5-coder:32b-instruct
LOCAL_PRIMARY_MODEL=qwen2.5-coder:32b-instruct

# -- Frontier APIs (optional fallback / improver) -----------------------------

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

FRONTIER_PRIMARY_MODEL=claude-sonnet-4-5-20250929
FRONTIER_OPENAI_MODEL=gpt-4o
FRONTIER_GOOGLE_MODEL=gemini-2.0-flash-exp

# -- Behaviour ----------------------------------------------------------------

# When the local model returns a suspicious response, re-run through the
# frontier-fallback group and patch the message with the improved content.
ENABLE_FRONTIER_IMPROVER=false

# Verbose request logging. Useful for debugging the proto -> chat-completion
# translation. Will log proto field names but not user-content payloads.
SHIM_LOG_LEVEL=info
