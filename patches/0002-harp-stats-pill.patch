+//! Live "L:R" pill — polls Harp's `/stats` endpoint once per second and exposes
+//! the latest snapshot to the right-side tab-bar pill. Hidden whenever `/stats`
+//! is unreachable, so a vanilla Warp OSS launch (no Harp on the configured
+//! server URL) shows nothing.
+//!
+//! Shipped from the Harp project as
+//! `patches/0002-harp-stats-pill.patch` against the Warp OSS checkout.
+
+use std::sync::Arc;
+use std::time::Duration;
+
+use serde::Deserialize;
+use warp_core::channel::ChannelState;
+use warpui::r#async::Timer;
+use warpui::{Entity, ModelContext, SingletonEntity};
+
+/// Snapshot of Harp's `/stats` endpoint. Fields mirror the JSON produced by
+/// `src/harp/stats.py` exactly — see also `scripts/harp-watch` for the
+/// terminal dashboard that consumes the same shape.
+#[derive(Clone, Debug, Default, Deserialize, PartialEq)]
+#[serde(default)]
+pub struct HarpStatsSnapshot {
+    pub total: u64,
+    pub served_local: u64,
+    pub forwarded_upstream: u64,
+    pub errors: u64,
+    pub local_serve_ratio: f64,
+    pub uptime_s: f64,
+}
+
+/// Singleton model that owns the latest [`HarpStatsSnapshot`] plus a
+/// reachability flag. Polled in the background via `ctx.spawn` + `Timer`,
+/// matching the existing recurring-poll pattern in `autoupdate::Autoupdate`.
+pub struct HarpStatsModel {
+    snapshot: Option<HarpStatsSnapshot>,
+    reachable: bool,
+    client: Arc<http_client::Client>,
+}
+
+impl HarpStatsModel {
+    /// Cadence — matches `scripts/harp-watch`.
+    const POLL_INTERVAL: Duration = Duration::from_secs(1);
+
+    pub fn new(ctx: &mut ModelContext<Self>) -> Self {
+        let mut me = Self {
+            snapshot: None,
+            reachable: false,
+            client: Arc::new(http_client::Client::new()),
+        };
+        me.poll(ctx);
+        me
+    }
+
+    pub fn snapshot(&self) -> Option<&HarpStatsSnapshot> {
+        self.snapshot.as_ref()
+    }
+
+    pub fn reachable(&self) -> bool {
+        self.reachable
+    }
+
+    /// `L:R 62:38`, or `L:R --:--` before any traffic has been observed (or
+    /// when `/stats` is unreachable). The remote share is computed as the
+    /// complement of the local share so the two values always sum to 100.
+    pub fn pill_label(&self) -> String {
+        match self.snapshot.as_ref() {
+            Some(s) if s.total > 0 => {
+                let local_pct = (s.local_serve_ratio.clamp(0.0, 1.0) * 100.0).round() as u32;
+                let local_pct = local_pct.min(100);
+                let remote_pct = 100u32 - local_pct;
+                format!("L:R {local_pct}:{remote_pct}")
+            }
+            _ => "L:R --:--".to_string(),
+        }
+    }
+
+    /// Multi-line tooltip that mirrors the headline numbers from
+    /// `harp-watch`: total / served-local / forwarded-upstream / uptime.
+    pub fn tooltip_label(&self) -> String {
+        match self.snapshot.as_ref() {
+            Some(s) => format!(
+                "Harp · /stats\n\
+                 Total:      {total}\n\
+                 Local:      {local}\n\
+                 Upstream:   {upstream}\n\
+                 Errors:     {errors}\n\
+                 Uptime:     {uptime:.0}s",
+                total = s.total,
+                local = s.served_local,
+                upstream = s.forwarded_upstream,
+                errors = s.errors,
+                uptime = s.uptime_s,
+            ),
+            None => "Harp · /stats\nWaiting for first sample…".to_string(),
+        }
+    }
+
+    /// Drives one poll round and self-reschedules. Same shape as
+    /// `Autoupdate::poll_for_update`: kick off the work synchronously, then
+    /// `ctx.spawn` a `Timer` whose continuation calls `poll` again.
+    fn poll(&mut self, ctx: &mut ModelContext<Self>) {
+        self.kick_off_fetch(ctx);
+        ctx.spawn(
+            async {
+                Timer::after(Self::POLL_INTERVAL).await;
+            },
+            |me, _, ctx| me.poll(ctx),
+        );
+    }
+
+    fn kick_off_fetch(&mut self, ctx: &mut ModelContext<Self>) {
+        let url = stats_url();
+        let client = self.client.clone();
+        ctx.spawn(
+            async move {
+                let response = match client.get(url.as_str()).send().await {
+                    Ok(response) => response,
+                    Err(_) => return None,
+                };
+                if !response.status().is_success() {
+                    return None;
+                }
+                response.json::<HarpStatsSnapshot>().await.ok()
+            },
+            |me, snapshot, ctx| me.apply_snapshot(snapshot, ctx),
+        );
+    }
+
+    fn apply_snapshot(
+        &mut self,
+        snapshot: Option<HarpStatsSnapshot>,
+        ctx: &mut ModelContext<Self>,
+    ) {
+        let was_reachable = self.reachable;
+        let prev_snapshot = self.snapshot.clone();
+
+        match snapshot {
+            Some(snapshot) => {
+                self.reachable = true;
+                self.snapshot = Some(snapshot);
+            }
+            None => {
+                self.reachable = false;
+            }
+        }
+
+        if was_reachable != self.reachable || prev_snapshot != self.snapshot {
+            ctx.notify();
+        }
+    }
+}
+
+/// Builds `<server_root_url>/stats`, ensuring exactly one slash in the join.
+fn stats_url() -> String {
+    let base = ChannelState::server_root_url();
+    let trimmed = base.trim_end_matches('/');
+    format!("{trimmed}/stats")
+}
+
+pub enum HarpStatsEvent {}
+
+impl Entity for HarpStatsModel {
+    type Event = HarpStatsEvent;
+}
+
+impl SingletonEntity for HarpStatsModel {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn snapshot(total: u64, ratio: f64) -> HarpStatsSnapshot {
+        HarpStatsSnapshot {
+            total,
+            local_serve_ratio: ratio,
+            ..Default::default()
+        }
+    }
+
+    fn model_with(snapshot: Option<HarpStatsSnapshot>, reachable: bool) -> HarpStatsModel {
+        HarpStatsModel {
+            snapshot,
+            reachable,
+            client: Arc::new(http_client::Client::new_for_test()),
+        }
+    }
+
+    #[test]
+    fn pill_label_pre_traffic() {
+        let model = model_with(None, false);
+        assert_eq!(model.pill_label(), "L:R --:--");
+    }
+
+    #[test]
+    fn pill_label_zero_total() {
+        let model = model_with(Some(snapshot(0, 0.0)), true);
+        assert_eq!(model.pill_label(), "L:R --:--");
+    }
+
+    #[test]
+    fn pill_label_basic_ratio() {
+        let model = model_with(Some(snapshot(100, 0.62)), true);
+        assert_eq!(model.pill_label(), "L:R 62:38");
+    }
+
+    #[test]
+    fn pill_label_clamps_high_ratio() {
+        let model = model_with(Some(snapshot(50, 1.5)), true);
+        assert_eq!(model.pill_label(), "L:R 100:0");
+    }
+
+    #[test]
+    fn pill_label_clamps_negative_ratio() {
+        let model = model_with(Some(snapshot(50, -0.25)), true);
+        assert_eq!(model.pill_label(), "L:R 0:100");
+    }
+
+    #[test]
+    fn snapshot_deserializes_from_harp_stats_json() {
+        let raw = r#"{
+            "total": 76,
+            "served_local": 47,
+            "forwarded_upstream": 29,
+            "errors": 0,
+            "local_serve_ratio": 0.6184,
+            "uptime_s": 1234.5
+        }"#;
+        let s: HarpStatsSnapshot = serde_json::from_str(raw).unwrap();
+        assert_eq!(s.total, 76);
+        assert_eq!(s.served_local, 47);
+        assert_eq!(s.forwarded_upstream, 29);
+        assert_eq!(s.errors, 0);
+        assert!((s.local_serve_ratio - 0.6184).abs() < f64::EPSILON);
+        assert!((s.uptime_s - 1234.5).abs() < f64::EPSILON);
+    }
+
+    #[test]
+    fn snapshot_tolerates_missing_fields() {
+        // Defaults must apply when /stats is missing fields a future Harp
+        // version might add or rename, so the pill never crashes the UI.
+        let s: HarpStatsSnapshot = serde_json::from_str("{}").unwrap();
+        assert_eq!(s, HarpStatsSnapshot::default());
+    }
+}
