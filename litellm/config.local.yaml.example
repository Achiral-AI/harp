# Example LiteLLM config for a self-hosted, multi-replica OpenAI-compatible
# inference cluster (vLLM, TRT-LLM, SGLang, etc.) reachable on the local
# network — for example three GPU nodes exposed via a NodePort and connected
# via Tailscale.
#
# Copy this file to `litellm/config.local.yaml` and edit the URLs / model name.
# Then point LiteLLM at it from `.env`:
#
#     LITELLM_CONFIG=./litellm/config.local.yaml
#
# `litellm/config.local.yaml` is gitignored so personal endpoints don't end up
# in version control.

model_list:
  # ----- local-primary --------------------------------------------------------
  # Multiple deployments under the same `model_name` get round-robined by
  # LiteLLM's router (default `simple-shuffle`).
  - model_name: local-primary
    litellm_params:
      model: openai/Qwen3-32B-NVFP4
      api_base: http://100.103.112.113:30800/v1
      api_key: dummy

  - model_name: local-primary
    litellm_params:
      model: openai/Qwen3-32B-NVFP4
      api_base: http://100.118.131.57:30800/v1
      api_key: dummy

  - model_name: local-primary
    litellm_params:
      model: openai/Qwen3-32B-NVFP4
      api_base: http://100.73.108.7:30800/v1
      api_key: dummy

  # ----- frontier-fallback ----------------------------------------------------
  - model_name: frontier-fallback
    litellm_params:
      model: anthropic/${FRONTIER_PRIMARY_MODEL}
      api_key: ${ANTHROPIC_API_KEY}

  - model_name: frontier-openai
    litellm_params:
      model: openai/${FRONTIER_OPENAI_MODEL}
      api_key: ${OPENAI_API_KEY}

  - model_name: frontier-google
    litellm_params:
      model: gemini/${FRONTIER_GOOGLE_MODEL}
      api_key: ${GOOGLE_API_KEY}

litellm_settings:
  fallbacks:
    - local-primary: ["frontier-fallback", "frontier-openai", "frontier-google"]

  context_window_fallbacks:
    - local-primary: ["frontier-fallback"]

  # vLLM / TRT-LLM may not accept every OpenAI parameter; drop unknowns
  # rather than failing hard.
  drop_params: true

  set_verbose: false

router_settings:
  # Round-robin across the local-primary deployments declared above.
  routing_strategy: simple-shuffle

# No general_settings.master_key here: LiteLLM's master-key auth requires a
# connected database. For a single-user localhost stack we just leave the
# proxy unauthenticated (only Harp's container can reach it on the bridge
# network anyway).
